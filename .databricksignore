# Exclusions for `databricks sync` and the Databricks IDE extension.
#
# IMPORTANT: `databricks bundle deploy` does NOT read this file — it honors
# .gitignore plus the `sync.exclude:` block in databricks.yml. Keep this list
# ALIGNED with that block (it mirrors these paths) so the sync command and the
# bundle deploy exclude the same dev-only surfaces.
#
# The deploy MUST ship: pyproject.toml + src/** + examples/** (the example
# pipelines' code/config live under examples/; the framework is delivered as
# the datalab wheel built by the databricks.yml `datalab_wheel` artifact).

# Dev-only surfaces — not needed at runtime
tests/
examples/*/tests/
docs/
design/

# CI/CD + agent harness
.github/
.claude/
.cursor/
.codex/
.agents/
.githooks/
omnigent/
.mcp.json

# Local tooling
Makefile
uv.lock
.markdownlint.json
