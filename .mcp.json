{
  "mcpServers": {
    "databricks-sql": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "uc-mcp-proxy",
        "--url",
        "${DATABRICKS_MCP_HOST:-https://dbc-425be768-f138.cloud.databricks.com}/api/2.0/mcp/sql?warehouse_id=${DATABRICKS_SQL_WAREHOUSE_ID:-c1cdbe2406e5cf04}",
        "--auth-type",
        "databricks-cli",
        "--profile",
        "${DATABRICKS_CONFIG_PROFILE:-diggi_dev_aws}"
      ]
    }
  }
}
